{
  "expo": {
    "name": "Estante",
    "slug": "estante-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "estante",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.gabrielvalenco.estante",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.gabrielvalenco.estante",
      "adaptiveIcon": {
        "backgroundColor": "#FBFBFD",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#FBFBFD",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B0B0D"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "A Estante usa suas fotos só para você escolher a foto do perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7b1b505c-41f7-4f05-8bb7-a6bdb98cf16e"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/7b1b505c-41f7-4f05-8bb7-a6bdb98cf16e"
    }
  }
}
